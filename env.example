# sharkey-notes-cleaner 配置（/etc/default/sharkey-notes-cleaner）
# install.sh 会自动探测并填写这四项；换镜像/换 compose 目录后手动改这里即可。

# 应用镜像（必须与运行中的 web 容器一致，清理器就靠它拿到 ormconfig/entities）
# install.sh 会自动探测填写；<...> 是占位符，别照抄
# 注：万一该 tag 已被删除/prune，run.sh 会自动退回运行中应用容器的镜像 ID 并告警
CLEANER_IMAGE=<your-sharkey-image>
# 应用容器名（镜像缺失时用来兜底取镜像 ID），一般不用改
CLEANER_APP_CONTAINER=sharkey-web
# compose 网络名（清理容器要能解析 db / redis 服务名）
CLEANER_NETWORK=<compose项目名>_default
# 宿主上的 .config 目录（挂成容器内 /sharkey/.config:ro）
CLEANER_CONFIG_DIR=/path/to/compose/.config
# 镜像内应用根目录（一般不用改）
CLEANER_SHARKEY_HOME=/sharkey
# 通知命令：**只在异常时**被调用（非 0 退出 / fatal / 连续批失败 > 8）；留空则只写日志
# 例：你自己的 Telegram/邮件/webhook 脚本
CLEANER_NOTIFY_CMD=

# ── 清理参数 ────────────────────────────────────────────────────────────────
# 保留天数
EXPIRY_DAYS=90
# 每批删除条数上限
BATCH=2000
# 单次运行时间上限（分钟）
MAX_MINUTES=60
# 单次删除条数上限，0=不限
MAX_NOTES=0
# 批间休眠（毫秒）
SLEEP_MS=500
# 跨轮续跑的状态文件（容器内路径；宿主 $CLEANER_STATE_DIR 会挂到 /state）
STATE_FILE=/state/state.json
# 预先试跑（只统计不删除）时改成 1
# 注意：这里写 0 = 生产实删；若整个文件缺失，run.sh 的默认值是 1（只读）
DRY_RUN=0
